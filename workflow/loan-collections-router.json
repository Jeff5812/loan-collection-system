    {
      "parameters": {
        "jsCode": "const a = $json;\nconst legal_package = {\n  account_id: a.account_id,\n  customer_name: a.customer_name,\n  principal_balance: a.principal_balance,\n  days_past_due: a.days_past_due,\n  last_payment_date: a.last_payment_date,\n  last_payment_amount: a.last_payment_amount,\n  ai_rationale: a.rationale,\n  sentiment_score: a.sentiment_score,\n  referral_date: new Date().toISOString()\n};\n\nconst html_report = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: auto; color: #1a1a1a;\">\n  <h2 style=\"border-bottom: 2px solid #b91c1c; padding-bottom: 8px; color: #b91c1c;\">Legal Escalation — Account ${a.account_id}</h2>\n  <table style=\"width:100%; border-collapse: collapse; margin-top: 16px;\">\n    <tr><td style=\"padding:6px 0; font-weight:bold;\">Customer</td><td>${a.customer_name}</td></tr>\n    <tr><td style=\"padding:6px 0; font-weight:bold;\">Principal Balance</td><td>₦${Number(a.principal_balance).toLocaleString()}</td></tr>\n    <tr><td style=\"padding:6px 0; font-weight:bold;\">Days Past Due</td><td>${a.days_past_due}</td></tr>\n    <tr><td style=\"padding:6px 0; font-weight:bold;\">Last Payment</td><td>${a.last_payment_date} (₦${Number(a.last_payment_amount).toLocaleString()})</td></tr>\n    <tr><td style=\"padding:6px 0; font-weight:bold;\">Sentiment Score</td><td>${a.sentiment_score}</td></tr>\n  </table>\n  <p style=\"margin-top:20px;\"><strong>Case Summary:</strong> ${a.rationale}</p>\n  <p style=\"margin-top:24px; font-size: 13px; color: #555;\">Referral generated ${new Date().toLocaleDateString()} — for legal/collections review and next-step determination.</p>\n</div>`;\n\nreturn { json: { ...a, legal_package, html_report } };"
      },
