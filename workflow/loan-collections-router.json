    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    COUNT(*) AS accounts_processed,\n\n    COUNT(*) FILTER (\n        WHERE risk_tier = 'low'\n    ) AS low_count,\n\n    COUNT(*) FILTER (\n        WHERE risk_tier = 'medium'\n    ) AS medium_count,\n\n    COUNT(*) FILTER (\n        WHERE risk_tier = 'high'\n    ) AS high_count,\n\n    COUNT(*) FILTER (\n        WHERE channel = 'sms'\n    ) AS sms_sent,\n\n    COUNT(*) FILTER (\n        WHERE channel = 'whatsapp'\n    ) AS whatsapp_sent,\n\n    COUNT(*) FILTER (\n        WHERE channel = 'email_legal'\n    ) AS legal_referrals,\n\n    COUNT(*) FILTER (\n        WHERE action_taken = 'human_review_queue'\n    ) AS human_reviews,\n\n    COUNT(*) FILTER (\n        WHERE status = 'sent'\n    ) AS successful_actions,\n\n    COUNT(*) FILTER (\n        WHERE status = 'pending_review'\n    ) AS pending_reviews,\n\n    ROUND(AVG(confidence),2) AS avg_confidence\n\nFROM execution_log\n\nWHERE DATE(run_at) = CURRENT_DATE;",
        "options": {}
