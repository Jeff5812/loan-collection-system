    {
      "parameters": {
        "jsCode": "const original = { ...$('Parse AI Output').item.json };\noriginal.rationale = (original.rationale || '').replace(/,/g, ';');\n\nlet reference = null;\nlet channel = null;\n\ntry {\n  reference = $('SMS Reminder').item.json.sid;\n  channel = 'sms';\n} catch (e) {}\n\ntry {\n  reference = $('Restructuring Offer').item.json.messages[0].id;\n  channel = 'whatsapp';\n} catch (e) {}\n\ntry {\n  reference = $('Send Legal Referral').item.json.id;\n  channel = 'email_legal';\n} catch (e) {}\n\ntry {\n  $('Flag for Human Review').item.json.action_taken;\n  channel = channel || 'human_review';\n} catch (e) {}\n\nconst action_taken = channel === 'human_review' ? 'human_review_queue' : channel;\nconst status = channel === 'human_review' ? 'pending_review' : 'sent';\n\nconst execution_id =\n`COL-${new Date().toISOString().slice(0,10).replace(/-/g,'')}-${original.account_id}-${Math.random().toString(36).substring(2,6).toUpperCase()}`\n\nreturn {\n  json: {\n    ...original,\n    execution_id,\n    message_reference: reference,\n    channel: channel || 'unknown',\n    action_taken,\n    status\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        960
      ],
