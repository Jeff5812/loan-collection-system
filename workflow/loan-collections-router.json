{
  "name": "MICRO-LENDING COLLECTION, RESTRUCTURING AND LEGAL ROUTER",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this delinquent loan account and return ONLY a JSON object, no prose, no markdown fences.\n\nAccount data:\nCustomer: {{ $json.customer_name }}\nDays past due: {{ $json.days_past_due }}\nPrincipal balance: {{ $json.principal_balance }}\nLast payment date: {{ $json.last_payment_date }}\nLast payment amount: {{ $json.last_payment_amount }}\nMessage history: {{ $json.message_history }}\n\nReturn this exact JSON shape:\n{\n  \"risk_tier\": \"low\" | \"medium\" | \"high\",\n  \"sentiment_score\": number between -1 and 1,\n  \"confidence\": number between 0 and 1,\n  \"rationale\": \"one sentence explanation\"\n}\n\nGuidance: low = usually pays, isolated lateness, engages positively. medium = struggling but responsive/engaging. high = non-responsive, repeat default, or hostile/no engagement.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a credit risk and sentiment analyst for a consumer lending platform. You classify delinquent accounts into a risk tier and sentiment score based on payment history and communication tone. You always respond with valid JSON only."
        }
      },
      "id": "00ad70cb-0e6d-4b16-8e52-c39332c7921c",
      "name": "Risk & Sentiment Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -1632,
        1024
      ]
    },
    {
      "parameters": {
        "jsCode": "const parsed = $json.output;\nconst validTiers = ['low', 'medium', 'high'];\n\nif (!validTiers.includes(parsed.risk_tier)) {\n  parsed.risk_tier = 'review';\n  parsed.confidence = 0;\n  parsed.rationale = (parsed.rationale || '') + ' [invalid risk_tier defaulted to review]';\n}\n\nif (parsed.risk_tier === 'medium' && parsed.sentiment_score < -0.3) {\n  parsed.risk_tier = 'high';\n  parsed.rationale += ' [escalated to high: negative sentiment override]';\n}\n\nreturn {\n  json: {\n    ...$('Loop Accounts').item.json,\n    ...parsed\n  }\n};"
      },
