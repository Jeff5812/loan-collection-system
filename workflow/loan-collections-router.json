    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.account_id, a.customer_name, a.phone_number, a.email, a.principal_balance, \n       a.days_past_due, a.loan_product, a.last_payment_date, a.last_payment_amount, \n       i.message_history\nFROM accounts a\nLEFT JOIN interactions i ON i.account_id = a.account_id\nWHERE a.status = 'delinquent'\n  AND a.days_past_due > 0\n  AND (a.last_contacted_date IS NULL OR a.last_contacted_date < CURRENT_DATE)\nORDER BY a.days_past_due DESC;",
        "options": {}
      },
      "id": "1f9eeafd-0dbe-4d1c-809e-96841a54713f",
      "name": "Fetch Delinquent Accounts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -2112,
        1008
      ],
      "credentials": {
        "postgres": {
